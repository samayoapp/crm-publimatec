generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String     @id @default(uuid())
  name       String
  email      String     @unique
  password   String
  role       String     @default("ASESOR") // "ADMIN" o "ASESOR"
  jobTitle   String?    @default("Ejecutivo de Ventas")
  phone      String?
  avatarUrl  String?
  active     Boolean    @default(true)
  approved   Boolean    @default(true) // Aprobado por el Director
  status     String     @default("ACTIVE") // "ACTIVE" | "PENDING_APPROVAL" | "REJECTED"
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  contacts   Contact[]  @relation("AssignedContacts")
  proposals  Proposal[] @relation("AssignedProposals")
  activities Activity[]
  documents  Document[]
  folders    Folder[]
}

model Company {
  id         String     @id @default(uuid())
  name       String     // Nombre comercial (ej. Café Monte Alto)
  legalName  String?    // Razón social completa
  taxId      String?    // RTN / Identificación tributaria
  industry   String?    // Industria o sector (ej. Alimentos, Farmacéutica, Inmobiliaria)
  website    String?
  phone      String?
  email      String?
  address    String?
  city       String?    @default("San Pedro Sula")
  country    String?    @default("Honduras")
  logoUrl    String?    // Logotipo de la empresa
  notes      String?    // Observaciones o perfil institucional
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  contacts   Contact[]
  proposals  Proposal[]
}

model Contact {
  id               String     @id @default(uuid())
  name             String     // Nombre de la persona (ej. Lic. Mariana Zelaya)
  jobTitle         String?    // Cargo / Puesto (ej. Gerente de Mercadeo)
  companyId        String?
  company          Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyName      String?    // Nombre de empresa en texto (compatibilidad y rápido acceso)
  avatarUrl        String?    // Fotografía de la persona
  email            String?
  phone            String     // WhatsApp directo
  notes            String?    // Notas sobre la relación o antecedentes
  nextFollowUp     DateTime?  // Fecha del próximo contacto
  nextFollowUpTask String?    // Tarea o motivo del contacto
  assignedToId     String?
  assignedTo       User?      @relation("AssignedContacts", fields: [assignedToId], references: [id], onDelete: SetNull)
  firstContactAt   DateTime?  @default(now()) // Fecha del primer contacto real
  lastContactAt    DateTime?  @default(now()) // Fecha de la última interacción (para medir días sin respuesta)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  proposals        Proposal[]
  activities       Activity[]
  documents        Document[]
}

model Proposal {
  id             String     @id @default(uuid())
  title          String     // ej. "Rediseño Web + Catálogo" o "Branding 2026"
  amount         Float      @default(0) // Valor numérico
  currency       String     @default("USD")
  stage          String     @default("ENVIADA") // "NUEVO", "CONTACTADO", "PROPUESTA", "NEGOCIACION", "GANADO", "PERDIDO"
  notes          String?    // Alcances o detalles de la propuesta
  contactId      String
  contact        Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  companyId      String?
  company        Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  assignedToId   String?
  assignedTo     User?      @relation("AssignedProposals", fields: [assignedToId], references: [id], onDelete: SetNull)
  closedAt       DateTime?  // Fecha en que la venta se marcó como GANADO o PERDIDO
  stageUpdatedAt DateTime?  @default(now()) // Fecha en que ingresó a la etapa actual
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  activities     Activity[]
  documents      Document[]
}

model Activity {
  id          String    @id @default(uuid())
  type        String    // LLAMADA, WHATSAPP, REUNION, CORREO, NOTA, VENTA_CERRADA, CAMBIO_ETAPA
  description String
  contactId   String
  contact     Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  proposalId  String?
  proposal    Proposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
}

model Setting {
  id                 String   @id @default("default")
  companyName        String   @default("PixelMedia • Inversiones Publimatec")
  currency           String   @default("USD") // "USD", "HNL", "EUR"
  currencySymbol     String   @default("$")   // "$", "L", "€"
  taxRate            Float    @default(15.0)  // ISV 15%
  phone              String?  @default("+504 9900-1122")
  email              String?  @default("contacto@pixelmediahn.com")
  address            String?  @default("San Pedro Sula, Cortés, Honduras")
  logoUrl            String?
  monthlySalesTarget Float    @default(15000)
  motivationalQuotes String[] @default([])
  updatedAt          DateTime @updatedAt
}

model VerificationCode {
  id        String   @id @default(uuid())
  email     String
  code      String   // Código numérico de 6 dígitos
  type      String   // "REGISTER" | "PASSWORD_RESET"
  payload   String?  // JSON serializado con datos del registro pendiente
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, type])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String?  // Destinatario específico (ej. id del admin) o null para todos los directores
  type      String   // "NEW_USER_REGISTRATION" | "USER_APPROVED" | "SYSTEM"
  title     String
  message   String
  link      String?  // Enlace para acción rápida (/team o /dashboard)
  read      Boolean  @default(false)
  metadata  String?  // JSON string
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model Document {
  id              String    @id @default(uuid())
  title           String    // ej. "Cotización Rotulación Luminosa v2" o "Catálogo Pantallas LED 2026"
  description     String?   // Notas o alcances del documento
  fileUrl         String    // Ruta interna /uploads/documents/... o URL externa (Drive, Canva, etc.)
  fileType        String    // "PDF", "PPT", "EXCEL", "WORD", "IMAGE", "LINK"
  fileSize        Int?      // Tamaño en bytes si es archivo local
  category        String    @default("COTIZACION") // "COTIZACION", "PRESENTACION", "CATALOGO", "FICHA_TECNICA", "CONTRATO", "OTRO"
  tags            String[]  @default([])
  version         String?   @default("v1")
  isInstitutional Boolean   @default(false) // Si es TRUE, aparece en la Biblioteca Institucional para todos los asesores

  folderId        String?
  folder          Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)

  proposalId      String?
  proposal        Proposal? @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  contactId       String?
  contact         Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  uploadedById    String?
  uploadedBy      User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([proposalId])
  @@index([isInstitutional])
  @@index([uploadedById])
  @@index([folderId])
}

model Folder {
  id              String     @id @default(uuid())
  name            String
  color           String?    @default("indigo") // "indigo", "emerald", "amber", "rose", "purple", "cyan", "blue"
  isInstitutional Boolean    @default(false)
  userId          String?
  user            User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents       Document[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([isInstitutional])
  @@index([userId])
}

